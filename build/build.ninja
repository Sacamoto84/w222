  LANGUAGE_COMPILE_FLAGS = -march=rv32imafc_zicsr_zifencei_xesploop_xespv -mabi=ilp32f
  OBJECT_DIR = esp-idf\spiffs\CMakeFiles\__idf_spiffs.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = esp-idf\spiffs\libspiffs.a
