build esp-idf/spiffs/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D G:\w222\w222\build\esp-idf\spiffs && D:\Espressif5\tools\cmake\3.30.2\bin\cmake-gui.exe -SG:\w222\w222 -BG:\w222\w222\build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build esp-idf/spiffs/edit_cache: phony esp-idf/spiffs/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build esp-idf/spiffs/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D G:\w222\w222\build\esp-idf\spiffs && D:\Espressif5\tools\cmake\3.30.2\bin\cmake.exe --regenerate-during-build -SG:\w222\w222 -BG:\w222\w222\build"
  DESC = Running CMake to regenerate build system...
