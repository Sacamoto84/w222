build esp-idf/vfs/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D G:\w222\w222\build\esp-idf\vfs && D:\Espressif5\tools\cmake\3.30.2\bin\cmake-gui.exe -SG:\w222\w222 -BG:\w222\w222\build"
