  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D G:\w222\w222\build\esp-idf\main && D:\Espressif5\tools\cmake\3.30.2\bin\cmake-gui.exe -SG:\w222\w222 -BG:\w222\w222\build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build esp-idf/main/edit_cache: phony esp-idf/main/CMakeFiles/edit_cache.util


#############################################
