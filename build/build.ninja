# Utility command for list_install_components

build esp-idf/usb/list_install_components: phony


#############################################
# Utility command for install

build esp-idf/usb/CMakeFiles/install.util: CUSTOM_COMMAND esp-idf/usb/all
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D G:\w222\w222\build\esp-idf\usb && D:\Espressif5\tools\cmake\3.30.2\bin\cmake.exe -P cmake_install.cmake"
