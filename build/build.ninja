build esp-idf/usb/libusb.a: C_STATIC_LIBRARY_LINKER____idf_usb_ esp-idf/usb/CMakeFiles/__idf_usb.dir/hcd_dwc.c.obj esp-idf/usb/CMakeFiles/__idf_usb.dir/enum.c.obj esp-idf/usb/CMakeFiles/__idf_usb.dir/hub.c.obj esp-idf/usb/CMakeFiles/__idf_usb.dir/usb_helpers.c.obj esp-idf/usb/CMakeFiles/__idf_usb.dir/usb_host.c.obj esp-idf/usb/CMakeFiles/__idf_usb.dir/usb_private.c.obj esp-idf/usb/CMakeFiles/__idf_usb.dir/usbh.c.obj esp-idf/usb/CMakeFiles/__idf_usb.dir/usb_phy.c.obj || esp-idf/riscv/libriscv.a
  LANGUAGE_COMPILE_FLAGS = -march=rv32imafc_zicsr_zifencei_xesploop_xespv -mabi=ilp32f
  OBJECT_DIR = esp-idf\usb\CMakeFiles\__idf_usb.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = esp-idf\usb\libusb.a
  TARGET_PDB = usb.a.dbg


#############################################
# Utility command for edit_cache

build esp-idf/usb/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D G:\w222\w222\build\esp-idf\usb && D:\Espressif5\tools\cmake\3.30.2\bin\cmake-gui.exe -SG:\w222\w222 -BG:\w222\w222\build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build esp-idf/usb/edit_cache: phony esp-idf/usb/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build esp-idf/usb/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D G:\w222\w222\build\esp-idf\usb && D:\Espressif5\tools\cmake\3.30.2\bin\cmake.exe --regenerate-during-build -SG:\w222\w222 -BG:\w222\w222\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build esp-idf/usb/rebuild_cache: phony esp-idf/usb/CMakeFiles/rebuild_cache.util


